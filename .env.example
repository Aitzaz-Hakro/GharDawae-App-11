# Ghar Dawae — environment variables (copy to .env, fill real values)
# NEVER commit the real .env — it holds secrets. Only this .example is committed.

# Supabase (from your Supabase project settings → API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# PowerSync (M2) — from PowerSync dashboard → Connect → "instance URL"
EXPO_PUBLIC_POWERSYNC_URL=

# AI features (hackathon) — demo-scoped key, rotate after the event.
# EXPO_PUBLIC_* values are embedded in the app bundle; never put a service-role
# key or a personal production key here.
EXPO_PUBLIC_GEMINI_API_KEY=
# Optional overrides (defaults live in src/lib/ai/gemini.ts)
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash
EXPO_PUBLIC_GEMINI_ENDPOINT=

# ParchiiAI / Prescription Intelligence
# Reuses EXPO_PUBLIC_GEMINI_API_KEY above, or set an OpenAI key instead.
# Provide either EXPO_PUBLIC_OPENAI_API_KEY or EXPO_PUBLIC_GEMINI_API_KEY:
EXPO_PUBLIC_OPENAI_API_KEY=
# Optional serverless backend proxy for production releases:
# EXPO_PUBLIC_AI_PROXY_URL=https://your-serverless-ai-proxy.com/api/analyze

# Speech-to-text for the assistant's mic button.
# Default is Groq Whisper; xAI Grok STT works by changing the endpoint/model.
# Use a demo-scoped key: EXPO_PUBLIC_* is embedded in the app bundle.
EXPO_PUBLIC_STT_API_KEY=
EXPO_PUBLIC_STT_ENDPOINT=https://api.groq.com/openai/v1/audio/transcriptions
EXPO_PUBLIC_STT_MODEL=whisper-large-v3-turbo
# For xAI instead:
# EXPO_PUBLIC_STT_ENDPOINT=https://api.x.ai/v1/stt
# EXPO_PUBLIC_STT_MODEL=grok-voice-transcribe-2.0
